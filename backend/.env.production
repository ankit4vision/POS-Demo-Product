# Laravel Production Environment Variables
APP_NAME="Laravel"
APP_ENV=production
APP_KEY=base64:f+676nWSBxNKWHGpePpV+HBIrNz3LIEjunrVkn0qLBo=
APP_DEBUG=false
APP_URL=http://16.171.181.113

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=krimah_db_liv1
DB_USERNAME=krimah_user
DB_PASSWORD=krimah123

# Cache and Session (Production)
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis Configuration (Production)
# REDIS_HOST=your-redis-endpoint.region.cache.amazonaws.com
# REDIS_PASSWORD=your_redis_password
# REDIS_PORT=6379

# Mail Configuration (Production)
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-server.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (Production)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-s3-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher Configuration (Production)
PUSHER_APP_ID=your-pusher-app-id
PUSHER_APP_KEY=your-pusher-app-key
PUSHER_APP_SECRET=your-pusher-app-secret
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Frontend Variables (for Vite)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Application Specific (Production)
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com
SESSION_DOMAIN=.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security (Production)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
APP_ENCRYPTION_KEY=your-encryption-key

# File Upload (Production)
UPLOAD_MAX_FILESIZE=50MB
MAX_FILE_UPLOADS=50

# Performance (Production)
CACHE_TTL=3600
SESSION_TTL=7200 